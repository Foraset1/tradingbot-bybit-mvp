# VM profile: 6 vCPU, 10 GB RAM, 100 GB disk.
# Collector leaves resources for Ubuntu, Docker, health checks and later services.
TRADINGBOT_COLLECTOR_CPUS=4.0
TRADINGBOT_COLLECTOR_MEMORY=6g
TRADINGBOT_SHADOW_CPUS=1.5
TRADINGBOT_SHADOW_MEMORY=2g
TRADINGBOT_MIN_FREE_BYTES=16106127360
TRADINGBOT_ARCHIVE_ROOT=/data/archive
TRADINGBOT_RAW_RETENTION_DAYS=7
TRADINGBOT_HISTORY_ROOT=/data/history

# Public market-data collection does not require API credentials.
TRADINGBOT_CONFIG=/app/config/tradingbot.toml
TRADINGBOT_DATA_ROOT=/data/raw
TRADINGBOT_HEALTH_PATH=/app/runtime/collector-health.json
# Set these only after build-shadow-bundle succeeds. The shadow profile remains
# public-read-only and deliberately refuses any trading-key environment variable.
# TRADINGBOT_SHADOW_BUNDLE=/data/shadow-bundles/shadow-bundle-v1-<fingerprint>
# TRADINGBOT_SHADOW_RUN_ID=shadow-h15-n50-v1
# BYBIT_PUBLIC_WS_URL=wss://stream.bybit.com/v5/public/linear
